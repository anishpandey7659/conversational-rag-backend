APP_ENV=development
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Configure either or both providers; LLM_PROVIDER selects the active one.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GROQ_API_KEY=
# Optional fallback key shared by the selected provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

# Local Sentence Transformers model; the first request downloads it if uncached.
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
MAX_UPLOAD_SIZE_BYTES=10485760
CHAT_HISTORY_LIMIT=12
CHAT_SESSION_TTL_SECONDS=86400
RETRIEVAL_TOP_K=5
AUTO_CREATE_TABLES=true
